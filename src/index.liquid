---
layout: layout.liquid
title: Stupid Genius
---
<div class="home" id="home">
  <div class="grid">
    {%- for p in products -%}
      {%- assign total = 0 -%}
      {%- for s in p.sizes -%}{%- assign total = total | plus: s[1] -%}{%- endfor -%}
      {%- if total > 0 -%}
        <a class="card" href="/?product={{ p.slug }}"
           data-slug="{{ p.slug }}"
           data-name="{{ p.name }}"
           data-price="{{ p.price }}"
           data-sizes='{{ p.sizes | toJson }}'
           data-paypal="{{ config.paypal }}"
           data-revolut="{{ config.revolut }}"
           data-currency="{{ config.currency }}"
           data-revolut-prefill="{{ config.revolutPrefill }}"
           style="--i:{{ forloop.index0 }}">
          <div class="card-img">
            <img class="main" src="{{ p.images[0] }}" alt="{{ p.name }}" loading="lazy">
            {% if p.images[1] %}<img class="hover" src="{{ p.images[1] }}" alt="" loading="lazy">{% endif %}
          </div>
          <div class="card-meta">
            <h2>{{ p.name | upcase }}</h2>
            <span class="price">€ {{ p.price }}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}

    {%- for p in products -%}
      {%- assign total = 0 -%}
      {%- for s in p.sizes -%}{%- assign total = total | plus: s[1] -%}{%- endfor -%}
      {%- if total == 0 -%}
        <a class="card is-soldout" href="/?product={{ p.slug }}"
           data-slug="{{ p.slug }}"
           data-name="{{ p.name }}"
           data-price="{{ p.price }}"
           data-sizes='{{ p.sizes | toJson }}'
           data-paypal="{{ config.paypal }}"
           data-revolut="{{ config.revolut }}"
           data-currency="{{ config.currency }}"
           data-revolut-prefill="{{ config.revolutPrefill }}"
           style="--i:{{ forloop.index0 | plus: 6 }}">
          <div class="card-img">
            <img class="main" src="{{ p.images[0] }}" alt="{{ p.name }}" loading="lazy">
            {% if p.images[1] %}<img class="hover" src="{{ p.images[1] }}" alt="" loading="lazy">{% endif %}
          </div>
          <div class="card-meta">
            <h2>{{ p.name | upcase }}</h2>
            <span class="price">€ {{ p.price }}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<div class="product-panel" id="product-panel" hidden>
  <div class="panel-top">
    <button class="product-back" id="product-back" type="button" aria-label="Torna ai prodotti">
      <span class="chevron">‹</span> INDIETRO
    </button>
    <div class="img-toggle-group" id="img-toggle-group">
      <button class="img-toggle on" data-img="0" aria-label="Fronte">F</button>
      <button class="img-toggle" data-img="1" aria-label="Retro">B</button>
    </div>
  </div>
  <div class="bottom-info">
    <h1 class="pp-name" id="pp-name"></h1>
    <span class="pp-price" id="pp-price"></span>
  </div>
  <div class="capsule" id="capsule"></div>
</div>

<section class="step-pay" id="step-pay" hidden>
  <div class="pay-card">
    <div class="panel-top">
      <button class="product-back" id="back" type="button" aria-label="Torna alle taglie">
        <span class="chevron">‹</span> INDIETRO
      </button>
    </div>
    <div class="bottom-info" style="margin-bottom: 4px;">
      <h1 class="pp-name" id="summary-name"></h1>
      <span class="pp-price" id="summary-price"></span>
    </div>
    <div class="methods">
      <button class="method" data-method="paypal">PAYPAL</button>
      <button class="method" data-method="revolut">REVOLUT</button>
    </div>
    <div id="qr" class="qr"></div>
    <p id="qr-note" class="hint"></p>
  </div>
</section>

<script src="/js/qrcode.js"></script>
<script src="/js/home.js"></script>